*{box-sizing:border-box} :root{--pink:#ff4f9b;--pink2:#ff8fc8;--blue:#1778ff;--deep:#201326;--soft:#fff1f8;--card:rgba(255,255,255,.84);--shadow:0 28px 70px rgba(80,0,45,.22);--gold:#ffd36a} html,body{height:100%} body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;background:#180a20;color:#241421;min-height:100vh;overflow:hidden}.app-shell{min-height:100vh;position:relative}.screen{position:absolute;inset:0;display:none;overflow:hidden;padding:24px}.screen.active{display:flex;animation:screenIn .55s ease both}@keyframes screenIn{from{opacity:0;transform:scale(.985)}to{opacity:1;transform:scale(1)}}button{font:inherit}.btn{border:0;border-radius:999px;padding:15px 22px;font-weight:900;letter-spacing:-.01em;cursor:pointer;transition:.25s transform,.25s box-shadow,.25s opacity,.25s background}.btn:active{transform:scale(.97)}.btn-primary{color:#fff;background:linear-gradient(135deg,#1778ff,#6c5cff);box-shadow:0 16px 32px rgba(23,120,255,.32)}.btn-primary:hover{transform:translateY(-2px)}.btn-disabled{background:#d2c9d0;color:#8f8390;cursor:not-allowed;box-shadow:inset 0 1px 0 rgba(255,255,255,.55)}.btn-soft{background:rgba(255,255,255,.82);color:#8c2558;box-shadow:var(--shadow)}.hidden{display:none!important}.audio-lock{position:fixed;inset:0;z-index:9999;background:rgba(20,8,28,.06);display:grid;place-items:end center;pointer-events:auto;padding:0 18px 22px}.audio-lock>div{background:rgba(255,255,255,.94);border:1px solid rgba(255,255,255,.9);border-radius:999px;padding:10px 16px;display:flex;gap:10px;align-items:center;box-shadow:0 18px 42px rgba(80,0,45,.18);font-weight:850;color:#6b3451}.audio-lock p{margin:0}.mini-wave{width:16px;height:16px;border-radius:50%;background:var(--pink);display:block;box-shadow:0 0 0 0 rgba(255,79,155,.45);animation:pulseLock 1.2s infinite}@keyframes pulseLock{70%{box-shadow:0 0 0 12px rgba(255,79,155,0)}}
.start-screen{align-items:center;justify-content:center;background:radial-gradient(circle at 20% 10%,#ffd4ea 0,#ffedf6 32%,#fff 70%)}.rose-scene{position:absolute;inset:0;overflow:hidden}.orb{position:absolute;border-radius:50%;filter:blur(6px);opacity:.45;animation:float 8s ease-in-out infinite}.orb-1{width:210px;height:210px;background:#ff62a8;left:-50px;top:60px}.orb-2{width:280px;height:280px;background:#ffc4df;right:-80px;bottom:90px;animation-delay:1.5s}.orb-3{width:140px;height:140px;background:#ff8fc8;right:24%;top:16%;animation-delay:2.8s}.petals:before,.petals:after{content:'♡';position:absolute;color:#ff4f9b;font-size:56px;opacity:.22;animation:petal 9s linear infinite}.petals:before{left:15%;top:15%}.petals:after{right:18%;top:30%;animation-delay:3s}@keyframes float{50%{transform:translateY(-24px) translateX(18px)}}@keyframes petal{from{transform:translateY(-40px) rotate(0)}to{transform:translateY(100vh) rotate(360deg)}}.glass-card{position:relative;background:rgba(255,255,255,.72);border:1px solid rgba(255,255,255,.9);box-shadow:var(--shadow);backdrop-filter:blur(16px);border-radius:34px}.intro-card{width:min(430px,100%);text-align:center;padding:36px}.mini-label,.overline{color:#cf3277;font-weight:950;text-transform:uppercase;letter-spacing:.14em;font-size:12px}.intro-card h1{font-size:58px;letter-spacing:-.07em;margin:10px 0;background:linear-gradient(135deg,#ff348e,#7b3cff);-webkit-background-clip:text;color:transparent}.intro-card p{color:#7b536b;line-height:1.5}.big{margin-top:14px;width:100%}
.compatibility-screen{background:radial-gradient(circle at top,#ffe3f0 0,#fff8fc 50%,#ffe5f2 100%);overflow:auto;display:none;flex-direction:column;align-items:center}.compatibility-screen.active{display:flex}.top-glow{position:absolute;top:-120px;width:420px;height:220px;background:#ff92c8;filter:blur(70px);opacity:.48}.brand-row{width:min(560px,100%);display:flex;gap:14px;align-items:center;margin:8px auto 22px;position:relative;z-index:1}.brand-row h2{margin:2px 0 0;font-size:22px}.logo-pulse{width:54px;height:54px;border-radius:18px;background:linear-gradient(135deg,#ff4f9b,#7b61ff);display:grid;place-items:center;box-shadow:0 14px 28px rgba(255,79,155,.24)}.logo-pulse span{width:20px;height:20px;border-radius:50%;background:#fff;animation:pulse 1.4s infinite}@keyframes pulse{50%{transform:scale(.72);opacity:.7}}.main-bubble{width:min(560px,100%);background:rgba(255,255,255,.75);border:1px solid rgba(255,255,255,.95);border-radius:38px;box-shadow:var(--shadow);padding:28px 22px;text-align:center;position:relative;z-index:1}.ai-ring{width:114px;height:114px;border-radius:50%;background:conic-gradient(from 0deg,#ff4f9b,#1778ff,#ffb1d4,#ff4f9b);padding:7px;margin:0 auto 12px;animation:spin 8s linear infinite}.ai-core{height:100%;border-radius:50%;display:grid;place-items:center;background:#fff;font-size:44px;color:#ff4f9b}@keyframes spin{to{transform:rotate(360deg)}}.main-bubble h1{font-size:40px;margin:4px 0;letter-spacing:-.05em}.main-bubble p{color:#71435c;min-height:45px;line-height:1.45}.profile-card{width:min(560px,100%);margin-top:16px;background:rgba(255,255,255,.82);border-radius:30px;padding:16px;display:flex;gap:16px;align-items:center;box-shadow:0 18px 50px rgba(80,0,45,.15)}.avatar{width:96px;height:96px;border-radius:50%;background:linear-gradient(135deg,#ffd4e8,#f7e3ff);display:grid;place-items:center;overflow:hidden;flex:0 0 auto;border:5px solid #fff;box-shadow:0 14px 26px rgba(0,0,0,.12)}.avatar img{width:100%;height:100%;object-fit:cover}.avatar span{display:none}.avatar.final{box-shadow:0 0 0 7px rgba(23,120,255,.12),0 18px 38px rgba(23,120,255,.18)}.profile-info{flex:1;text-align:left}.profile-name{font-weight:950;font-size:24px;margin:0}.profile-result{font-weight:850;color:#cf3277;margin:5px 0 10px}.bar{height:12px;border-radius:999px;background:#eadce6;overflow:hidden}.bar span{display:block;height:100%;width:0%;border-radius:inherit;background:linear-gradient(90deg,#ff4f9b,#1778ff);transition:width .8s ease}.checks{width:min(560px,100%);display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0}.check{background:rgba(255,255,255,.76);border-radius:18px;padding:12px;font-weight:850;color:#74435d;box-shadow:0 10px 24px rgba(80,0,45,.1);opacity:.45}.check span{display:inline-block;width:18px;height:18px;border-radius:50%;border:2px solid #bbb;margin-right:7px;vertical-align:-3px}.check.done{opacity:1}.check.done span{background:#2bd66f;border-color:#2bd66f}.profile-btn{margin:8px 0 40px;width:min(360px,100%)}.is-shaking{animation:shake .42s ease both}@keyframes shake{20%,60%{transform:translateX(-5px)}40%,80%{transform:translateX(5px)}}
.chat-screen{background:linear-gradient(160deg,#fff1f8,#f9fbff);align-items:center;justify-content:center}.chat-phone{width:min(430px,100%);height:min(800px,92vh);background:#fff;border-radius:42px;box-shadow:var(--shadow);overflow:hidden;border:1px solid rgba(255,255,255,.95);display:flex;flex-direction:column}.chat-header{height:78px;background:linear-gradient(135deg,#ffeff7,#fff);display:flex;align-items:center;gap:13px;padding:14px 18px;border-bottom:1px solid #f2ddeb}.back-dot{width:38px;height:38px;border-radius:50%;background:#fff;display:grid;place-items:center;font-size:30px;color:#d13b7f;box-shadow:0 6px 14px rgba(80,0,45,.08)}.chat-header strong{display:block}.chat-header small{color:#2bd66f;font-weight:800}.chat-body{flex:1;position:relative;background:radial-gradient(circle at 50% 20%,#fff 0,#fff4fa 60%,#ffe9f4 100%);display:grid;place-items:center;overflow:hidden}.empty-chat{text-align:center;color:#95627a}.empty-chat span{font-weight:950;color:#6c3751}.fake-input{height:70px;display:flex;align-items:center;gap:10px;padding:12px 14px;background:#fff;border-top:1px solid #f2ddeb}.fake-input span{flex:1;background:#f4eef3;border-radius:999px;padding:14px 16px;color:#a88496}.fake-input button{width:44px;height:44px;border:0;border-radius:50%;background:#ff4f9b;color:#fff;font-size:22px}.envelope{position:absolute;bottom:34%;left:50%;transform:translate(-50%,120%) scale(.25);width:150px;height:112px;border:0;background:transparent;cursor:pointer;opacity:0}.envelope.arrive{animation:envelopeIn 1.2s cubic-bezier(.16,1,.3,1) forwards}.body-env{position:absolute;inset:0;border-radius:20px;background:linear-gradient(135deg,#fff,#ffd8eb);display:grid;place-items:center;font-size:58px;box-shadow:0 22px 55px rgba(80,0,45,.23)}.flap{position:absolute;left:17px;top:-20px;width:116px;height:76px;background:#ff9bc9;clip-path:polygon(0 100%,50% 0,100% 100%);z-index:2;filter:drop-shadow(0 8px 12px rgba(80,0,45,.12))}.notif{position:absolute;right:-12px;top:-22px;background:#ff2d55;color:#fff;width:38px;height:38px;border-radius:50%;display:grid;place-items:center;font-weight:950;z-index:4;border:4px solid #fff}@keyframes envelopeIn{to{opacity:1;transform:translate(-50%,0) scale(1)}}
.letter-screen{background:linear-gradient(180deg,#ffeef7,#fff9fc);overflow:auto;justify-content:center}.letter-wrap{width:min(720px,100%);margin:0 auto;padding:18px 0 50px}.letter-header{text-align:center;margin-bottom:14px}.letter-header p{color:#cf3277;font-weight:950;text-transform:uppercase;letter-spacing:.12em;font-size:12px}.letter-header h1{font-size:34px;letter-spacing:-.04em;margin:8px 0 0}.love-letter{background:#fffdf9;border-radius:26px;padding:28px 22px;box-shadow:var(--shadow);border:1px solid rgba(255,255,255,.9);font-family:Georgia,serif;font-size:18px;line-height:1.75;color:#38222d}.love-letter p:first-child:first-letter{font-size:46px;color:#ff4f9b;font-weight:bold;line-height:.8}.home-btn{display:block;margin:24px auto 0;width:min(360px,100%)}
.home-screen,.photos-screen,.photo-detail-screen,.history-screen,.birthday-screen{display:none;background:linear-gradient(140deg,#ffeff7,#fff,#ffd4e8);overflow:auto;justify-content:center}.home-screen.active,.photos-screen.active,.photo-detail-screen.active,.history-screen.active,.birthday-screen.active{display:flex}.home-scroll,.sub-page{width:min(860px,100%);margin:0 auto;padding:22px 0 46px}.home-hero{text-align:center;width:100%;background:rgba(255,255,255,.7);border-radius:34px;padding:26px;box-shadow:var(--shadow);margin-bottom:18px}.home-hero h1,.sub-page h1{font-size:42px;margin:5px 0;letter-spacing:-.06em}.home-hero p,.small-muted{color:#75425d;line-height:1.5}.home-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;width:100%;margin-bottom:18px}.home-card{border:0;text-align:left;background:rgba(255,255,255,.8);border-radius:26px;padding:18px;box-shadow:0 16px 35px rgba(80,0,45,.12);cursor:pointer;color:#241421;transition:.22s transform,.22s box-shadow}.home-card:hover{transform:translateY(-3px);box-shadow:0 20px 42px rgba(80,0,45,.16)}.home-card span{font-size:30px}.home-card h3{margin:8px 0 5px}.home-card p{margin:0;color:#80516a;font-size:14px}.home-card-18 span{width:46px;height:46px;border-radius:16px;background:linear-gradient(135deg,#111,#ffd36a);display:grid;place-items:center;color:#fff;font-weight:950}.sub-page{text-align:center}.photo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin:18px 0}.photo-tile{border:0;padding:0;border-radius:18px;overflow:hidden;aspect-ratio:1/1;background:#fff;box-shadow:0 10px 24px rgba(80,0,45,.13);cursor:pointer;position:relative}.photo-tile img{width:100%;height:100%;object-fit:cover;display:block;transition:.25s transform}.photo-tile:hover img{transform:scale(1.06)}.photo-tile span{position:absolute;right:6px;bottom:6px;background:rgba(255,255,255,.82);color:#cf3277;border-radius:999px;padding:4px 8px;font-size:11px;font-weight:950}.small-back{margin-bottom:15px}.detail-img{width:min(560px,100%);max-height:58vh;object-fit:contain;background:#fff;border-radius:28px;box-shadow:var(--shadow);display:block;margin:0 auto 18px}.detail-text{background:rgba(255,255,255,.82);border-radius:28px;padding:22px;box-shadow:0 16px 35px rgba(80,0,45,.11);text-align:left}.detail-text h1{font-size:30px}.detail-text p:last-child{line-height:1.6;color:#65364f}.book-page{width:min(900px,100%);margin:0 auto;padding:18px 0 46px;position:relative}.book-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}.month-play{border:0;border-radius:999px;padding:13px 17px;font-weight:950;color:#fff;background:linear-gradient(135deg,#ff4f9b,#7b61ff);box-shadow:0 14px 28px rgba(255,79,155,.22);cursor:pointer}.helper-bubble{position:relative;background:rgba(255,255,255,.9);border:1px solid rgba(255,255,255,.9);border-radius:24px;padding:14px 16px;margin:0 0 14px auto;width:min(420px,100%);box-shadow:0 16px 34px rgba(80,0,45,.13);color:#6b3451}.helper-bubble strong{color:#cf3277}.helper-bubble p{margin:4px 0 0;line-height:1.35}.helper-bubble span{position:absolute;right:50px;top:-18px;width:26px;height:26px;border-right:4px solid #ff4f9b;border-top:4px solid #ff4f9b;transform:rotate(-35deg)}.book{perspective:1300px}.page-paper{min-height:62vh;background:#fffdf8;border-radius:20px;padding:34px clamp(20px,5vw,54px);box-shadow:inset 0 0 0 1px #f2e3d2,0 28px 70px rgba(80,0,45,.18);font-family:Georgia,serif;position:relative;transform-origin:left center;animation:pageOpen .7s ease both}.page-paper:before{content:'';position:absolute;left:20px;top:18px;bottom:18px;width:2px;background:linear-gradient(#ead5bf,#fff,#ead5bf)}@keyframes pageOpen{from{transform:rotateY(-9deg);opacity:.5}to{transform:rotateY(0);opacity:1}}.month-label{text-transform:uppercase;letter-spacing:.18em;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;color:#cf3277;font-size:12px;font-weight:950}.page-paper h1{font-size:32px;line-height:1.1;margin:8px 0 18px;color:#3b2530}.story-text{font-size:17px;line-height:1.78;color:#3a2a2f}.story-text p{margin:0 0 16px}.book-nav{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:16px}#pageIndicator{font-weight:950;color:#7d4b63}.birthday-screen{background:#050505;color:#fff;align-items:center}.birthday-card{width:min(520px,100%);text-align:center;background:radial-gradient(circle at top,#4b3412,#111);border:1px solid rgba(255,211,106,.36);border-radius:34px;padding:34px;box-shadow:0 28px 80px rgba(0,0,0,.4)}.gold-badge{width:110px;height:110px;border-radius:50%;background:linear-gradient(135deg,#ffd36a,#9a6a11);display:grid;place-items:center;margin:0 auto 16px;font-size:44px;font-weight:950;color:#111}.birthday-card h1{font-size:52px;margin:0}.birthday-card p{color:#ffe8a9;line-height:1.5}@media(max-width:560px){.screen{padding:16px}.intro-card{padding:26px}.intro-card h1{font-size:44px}.main-bubble h1{font-size:32px}.checks{grid-template-columns:1fr}.chat-phone{height:90vh;border-radius:34px}.home-grid{grid-template-columns:1fr}.love-letter{font-size:16.5px;padding:23px 19px}.home-hero h1,.sub-page h1{font-size:36px}.photo-grid{grid-template-columns:repeat(3,1fr);gap:7px}.photo-tile{border-radius:14px}.book-nav{display:grid;grid-template-columns:1fr;justify-items:center}.book-top{align-items:stretch}.book-top .btn,.month-play{flex:1}.page-paper{min-height:67vh;padding:26px 20px}.story-text{font-size:16px}.page-paper h1{font-size:27px}.helper-bubble{font-size:14px}.audio-lock{padding-bottom:18px}}
